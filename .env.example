# Local development only. Replace with your own PostgreSQL connection string.
DATABASE_URL="postgresql://allotment_dev:allotment_dev@localhost:5432/hostel_allotment?schema=public"

# Generate a unique secret with: npx auth secret
AUTH_SECRET="generate-a-unique-secret-before-running-the-app"

# Optional: Auth.js infers the host from request headers in normal deployments.
# AUTH_URL="http://localhost:3000"

# Used only by the one-time administrator bootstrap command.
# Set these in your local .env, run npm run auth:create-admin, then remove them.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
